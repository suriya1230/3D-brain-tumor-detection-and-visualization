# Copy to .env and fill in what you have. Nothing here is required to run
# ingestion or retrieval (steps 1-5) — only app/knowledge/answering.py
# (step 6, real LLM answers) needs at least one of the LLM keys below.

# --- Answer generation (app/knowledge/answering.py) ---
# Set one or both — knowledge_routes.py tries GROQ_API_KEY first and
# automatically falls through to ANTHROPIC_API_KEY if Groq is down or
# rate-limited. Groq is free-tier; Anthropic is paid per-token. Leaving
# both unset means eval/run_answer_eval.py can only run against
# StubClient (a deterministic pipeline check, not real answers).

# Groq console: https://console.groq.com
# Model catalogs change — check `client.models.list()` if this 404s.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic console: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- PubMed / PMC ingest (app/knowledge/ingest/pubmed.py) ---
# Optional. Without it, E-utilities is rate-limited to 3 req/s instead of
# 10. Register at https://www.ncbi.nlm.nih.gov/account/settings/ (API Key
# Management section).
NCBI_API_KEY=

# --- Live web search (app/knowledge/web_search.py) ---
# Optional. Without it, /ask and /explain use the curated corpus only —
# nothing breaks, web results are just omitted. When set, results are
# restricted server-side to ALLOWED_DOMAINS in web_search.py (NCI, NIH,
# WHO, Cochrane, ASCO, ASTRO, etc.) — never open web search. Get a key at
# https://tavily.com (free tier available).
TAVILY_API_KEY=
